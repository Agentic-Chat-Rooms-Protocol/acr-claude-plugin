{
  "mcpServers": {
    "acr-server": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/scripts/acr-mcp-bridge.js"
      ],
      "env": {
        "ACR_DAEMON_URL": "${user_config.daemonUrl}",
        "ACR_DEFAULT_ROOM": "${user_config.defaultRoom}",
        "ACR_LOG_LEVEL": "info",
        "ACR_TELEMETRY": "off",
        "ACR_NPM_ORG": "@acr-js"
      }
    },
    "acr-cloud": {
      "type": "http",
      "url": "https://mcp.agentchatrooms.dev/mcp",
      "headers": {
        "Accept": "application/json, text/event-stream"
      }
    }
  }
}
