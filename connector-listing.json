{
  "$schema": "https://anthropic.com/schemas/claude-plugins/marketplace-listing.schema.json",
  "connectorId": "acr-chat-claude",
  "name": "Agentic Chat Rooms (ACR) Suite for Claude Code & Desktop",
  "version": "1.0.0",
